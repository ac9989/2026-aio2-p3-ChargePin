# Copy this file to .env. Never commit the real .env file.

# Keep true only in the local/test environment. /boom/1~5 returns 404 when false.
CHARGEPIN_ENABLE_TEST_SCENARIOS=true

# Docker Compose uses this internal container address for the Streamlit frontend.
CHARGEPIN_API_BASE_URL_DOCKER=http://backend:8000/api/v1

# Actual provider credentials. They are read only by the backend; do not expose them to the browser.
KECO_SERVICE_KEY=
KAKAO_REST_API_KEY=
# This browser map key is intentionally separate from the REST key.
KAKAO_JAVASCRIPT_KEY=

# Real provider cache and data-quality policy. Keep a small status cache to avoid request bursts.
KECO_INFO_CACHE_TTL_SECONDS=600
KECO_STATUS_CACHE_TTL_SECONDS=30
CHARGER_FRESHNESS_MINUTES=30

# First-screen demo login keys. Use different values in a shared/deployed environment.
CUSTOMER_SERVICE_KEY=
LOW_MANAGER_SERVICE_KEY=
HIGH_MANAGER_SERVICE_KEY=
